{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenith.local/schemas/deepsky-ab-run-v2.json",
  "title": "Zenith deep-sky scientific A/B run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "runIndex",
    "datasetId",
    "scenarioIds",
    "captureClass",
    "rawSetSha256",
    "stacker",
    "stackerVersion",
    "parametersSha256",
    "hardwareId",
    "cacheState",
    "cropId",
    "linearScaleId",
    "completed",
    "elapsedSeconds",
    "decisionSha256",
    "cfaSha256",
    "scientificMetricsSha256",
    "metrics",
    "outputs",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "zenith-deepsky-ab-run-v2" },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "runIndex": { "type": "integer", "minimum": 1, "maximum": 5 },
    "datasetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
      }
    },
    "captureClass": {
      "enum": ["broadbandOsc", "broadbandMono", "dualBandOsc", "monoNarrowband"]
    },
    "rawSetSha256": { "$ref": "#/$defs/sha256" },
    "stacker": { "enum": ["Zenith", "WBPP", "DSS", "APP"] },
    "stackerVersion": { "type": "string", "minLength": 1 },
    "parametersSha256": { "$ref": "#/$defs/sha256" },
    "hardwareId": { "type": "string", "minLength": 1 },
    "cacheState": { "enum": ["cold", "warm"] },
    "cropId": { "type": "string", "minLength": 1 },
    "linearScaleId": { "type": "string", "minLength": 1 },
    "completed": { "const": true },
    "elapsedSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "decisionSha256": { "$ref": "#/$defs/sha256" },
    "cfaSha256": { "$ref": "#/$defs/sha256" },
    "scientificMetricsSha256": { "$ref": "#/$defs/sha256" },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "required": [
        "flatResidualPercent",
        "darkPatternResidualPercent",
        "syntheticPhotometryBiasPercent",
        "realPhotometryBiasPercent",
        "registrationP95Px",
        "eidrGeometryP95Px",
        "varianceCoverageErrorPoints",
        "tileSeamSigma",
        "readAmplification",
        "readAmplificationHard",
        "rssFraction",
        "gpuReadbackFraction",
        "coverageNoSignalViolations",
        "artificialFrequencyViolations",
        "negativeJacobianViolations",
        "allocationFailureCount",
        "gpuOffered",
        "gpuSpeedup",
        "snr",
        "fwhmPx",
        "backgroundRms",
        "photometryBiasPercent",
        "artifactScore"
      ],
      "properties": {
        "flatResidualPercent": { "$ref": "#/$defs/nonNegativeNumber" },
        "darkPatternResidualPercent": { "$ref": "#/$defs/nonNegativeNumber" },
        "syntheticPhotometryBiasPercent": { "$ref": "#/$defs/nonNegativeNumber" },
        "realPhotometryBiasPercent": { "$ref": "#/$defs/nonNegativeNumber" },
        "registrationP95Px": { "$ref": "#/$defs/nonNegativeNumber" },
        "eidrGeometryP95Px": { "$ref": "#/$defs/nonNegativeNumber" },
        "varianceCoverageErrorPoints": { "$ref": "#/$defs/nonNegativeNumber" },
        "tileSeamSigma": { "$ref": "#/$defs/nonNegativeNumber" },
        "readAmplification": { "$ref": "#/$defs/nonNegativeNumber" },
        "readAmplificationHard": { "$ref": "#/$defs/nonNegativeNumber" },
        "rssFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "gpuReadbackFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "coverageNoSignalViolations": { "$ref": "#/$defs/nonNegativeInteger" },
        "artificialFrequencyViolations": { "$ref": "#/$defs/nonNegativeInteger" },
        "negativeJacobianViolations": { "$ref": "#/$defs/nonNegativeInteger" },
        "allocationFailureCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "gpuOffered": { "type": "integer", "enum": [0, 1] },
        "gpuSpeedup": { "$ref": "#/$defs/nonNegativeNumber" },
        "snr": { "$ref": "#/$defs/nonNegativeNumber" },
        "fwhmPx": { "$ref": "#/$defs/nonNegativeNumber" },
        "backgroundRms": { "$ref": "#/$defs/nonNegativeNumber" },
        "photometryBiasPercent": { "$ref": "#/$defs/nonNegativeNumber" },
        "artifactScore": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masters", "variance", "dq", "recipe", "logs"],
      "properties": {
        "masters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "variance": { "$ref": "#/$defs/artifact" },
        "dq": { "$ref": "#/$defs/artifact" },
        "recipe": { "$ref": "#/$defs/artifact" },
        "logs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\]).+"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
