{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "Zenith Astro Stacker",
  "version": "0.2.6",
  "identifier": "com.emg.zenith.astro.stacker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zenith Astro Stacker",
        "width": 650,
        "height": 400,
        "minWidth": 650,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false,
        "hiddenTitle": true,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Zenith Astro Code",
    "shortDescription": "Zenith Astro Stacker by Zenith Astro Code",
    "category": "Photography",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/eduardomg1499/astro-stacker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0ODM3QUI3MDg3RDc2NTMKUldSVGRuMEl0M3FEdEYvN1dkc3ZTNGJwWnphLzlvL3M3UjhsOCt3UWFKckJjanNmUEp2TU1sbzEK"
    }
  }
}
