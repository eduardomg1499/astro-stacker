# Dependencies
node_modules/

# Frontend build output
dist/

# Rust/Tauri build output
src-tauri/target/
src-tauri/gen/schemas/

# Local FFmpeg runtime binaries. Keep them local per platform.
src-tauri/bin/ffmpeg*
src-tauri/bin/ffprobe*
!src-tauri/bin/README.md

# Editor and OS metadata
.DS_Store
.AppleDouble
.LSOverride
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs and generated release artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build_output.txt
build_installer.txt
latest.json

# Temporary local scripts and diagnostics
*.tmp
*.bak

# Trazas del benchmark E2E planetario (perf_trace)
benchmarks/telemetry/

# Artefactos locales de QA visual e informes generados (no fuente)
tmp/
output/

# Config local del entorno de trabajo (no se comparte).
.claude/

# Salidas de auditoría y QA: se regeneran y pesan cientos de MB.
artifacts/
