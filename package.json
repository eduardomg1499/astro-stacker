{
  "name": "astro-stacker",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release:latest-json": "node scripts/release/generate-latest-json.mjs",
    "release:mac": "bash scripts/release/build-macos-release.sh",
    "release:mac:intel": "MACOS_BUILD_TARGET=x86_64-apple-darwin ARCH_LABEL=x86_64 bash scripts/release/build-macos-release.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "test:batch-output": "node --test scripts/batch-output.test.mjs",
    "test:benchmark-report": "node --test scripts/benchmark/planetary-e2e-report.test.mjs",
    "benchmark:deepsky-ab": "node scripts/benchmark/deepsky-ab-report.mjs",
    "test:deepsky-ab": "node --test scripts/benchmark/deepsky-ab-report.test.mjs",
    "test:settings-layout": "node --test scripts/settings-layout.test.mjs",
    "test:planetary-contracts": "npm run test:batch-output && npm run test:benchmark-report && npm run test:settings-layout",
    "test:deepsky-contracts": "node --test scripts/deepsky-contracts.test.mjs && npm run test:deepsky-ab",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run rust:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^5.0.0"
  }
}
