{
  "name": "astro-stacker",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "release:latest-json": "node scripts/release/generate-latest-json.mjs",
    "release:mac": "bash scripts/release/build-macos-release.sh",
    "release:mac:intel": "MACOS_BUILD_TARGET=x86_64-apple-darwin ARCH_LABEL=x86_64 bash scripts/release/build-macos-release.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run test && npm run build && npm run rust:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tauri-apps/plugin-updater": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^5.0.0"
  }
}
